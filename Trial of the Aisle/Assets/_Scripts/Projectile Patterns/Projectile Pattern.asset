  m_Script: {fileID: 11500000, guid: 596055ad1c9c620419d5716e5bd28f2a, type: 3}
  m_Name: Projectile Pattern
  m_EditorClassIdentifier: 
  _projectilePatterns:
  - thisPatternType: 1
    thisPatternTypeModifiers:
    - modName: Number of Projectiles
      modValue: 1
      modVariableType: 6
      modTooltip: 
      modVisibleInInspector: 1
    - modName: Spread Angle
      modValue: 1
      modVariableType: 0
      modTooltip: The distance each projectile should be from one another
      modVisibleInInspector: 1
    - modName: Spread Speed Increase
      modValue: 0
      modVariableType: 0
      modTooltip: The initial speed of each sequential projectile will increase by
        this amount
      modVisibleInInspector: 1
    - modName: Delay Between Projectiles
      modValue: 0
      modVariableType: 2
      modTooltip: How many seconds to wait before spawning the next sequential projectile
      modVisibleInInspector: 1
    - modName: Mirror
      modValue: 0
      modVariableType: 7
      modTooltip: Mirrors the Spread projectiles based on the initial angle
      modVisibleInInspector: 1
    - modName: Shift
      modValue: 0
      modVariableType: 7
      modTooltip: If we should shift the spread projectiles so the middle projectile
        will be where the inital angle is
      modVisibleInInspector: 1
    - modName: Center Remove Number
      modValue: 0
      modVariableType: 6
      modTooltip: The spread projectiles to remove starting at the centre of the
        spread. Can be used if you want to create a gap/opening in the middle
      modVisibleInInspector: 1
    thisPatternIsFoldout: 1
    thisPatternIsActive: 1
