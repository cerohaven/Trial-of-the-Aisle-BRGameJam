  _projectilePatterns:
  - thisPatternType: 1
    thisPatternTypeModifiers:
    - modName: Number of Projectiles
      modValue: 6
      modVariableType: 6
      modTooltip: 
      modVisibleInInspector: 1
    - modName: Spread Angle
      modValue: 41.36
      modVariableType: 0
      modTooltip: The distance each projectile should be from one another
      modVisibleInInspector: 1
    - modName: Spread Speed Increase
      modValue: 0
      modVariableType: 0
      modTooltip: The initial speed of each sequential projectile will increase by
        this amount
      modVisibleInInspector: 1
    - modName: Delay Between Projectiles
      modValue: 0
      modVariableType: 2
      modTooltip: How many seconds to wait before spawning the next sequential projectile
      modVisibleInInspector: 1
    - modName: Mirror
      modValue: 1
      modVariableType: 7
      modTooltip: Mirrors the Spread projectiles based on the initial angle
      modVisibleInInspector: 1
    - modName: Shift
      modValue: 0
      modVariableType: 7
      modTooltip: If we should shift the spread projectiles so the middle projectile
        will be where the inital angle is
      modVisibleInInspector: 0
    - modName: Center Remove Number
      modValue: 0
      modVariableType: 6
      modTooltip: The spread projectiles to remove starting at the centre of the
        spread. Can be used if you want to create a gap/opening in the middle
      modVisibleInInspector: 1
    thisPatternIsFoldout: 1
    thisPatternIsActive: 1
  - thisPatternType: 4
    thisPatternTypeModifiers:
    - modName: Number of Projectiles
      modValue: 4
      modVariableType: 6
      modTooltip: 
      modVisibleInInspector: 1
    - modName: Angle Range
      modValue: 5
      modVariableType: 0
      modTooltip: The random distance from -value to +value the projectiles can be
        from the initial angle in the clump
      modVisibleInInspector: 1
    - modName: Speed Range
      modValue: 0.5
      modVariableType: 0
      modTooltip: The random speed from -value to +value each projectile in the clump
        can have
      modVisibleInInspector: 1
    - modName: Fire Delay Range
      modValue: 0.1
      modVariableType: 0
      modTooltip: 'The random delay from -value to +value to spawn each projectile
        in the clump '
      modVisibleInInspector: 1
    thisPatternIsFoldout: 1
    thisPatternIsActive: 1
